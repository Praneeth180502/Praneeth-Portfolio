# ============================================================================
# AI Portfolio Backend — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ----------------------------------------------------------------- App
APP_NAME="AI Portfolio Backend"
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                # set true in production for structured logs

HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------- CORS
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://praneeth-portfolio-n2na.vercel.app

# ----------------------------------------------------------------- Database
# Async DSN used by the running app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_db
# Sync DSN used only by Alembic migrations (psycopg2 driver).
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/portfolio_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ----------------------------------------------------------------- Redis
# Reserved for future expansion (response caching, distributed rate limiting).
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ----------------------------------------------------------------- Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60

# ----------------------------------------------------------------- RAG
# Paths are relative to the project root; overrides rarely needed.
# KNOWLEDGE_DIR=./knowledge
# CHROMA_PERSIST_DIR=./data/chroma
# BM25_INDEX_DIR=./data/bm25
CHROMA_COLLECTION_NAME=portfolio_knowledge

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

CHUNK_SIZE=700
CHUNK_OVERLAP=100

DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=0.0

CONVERSATION_HISTORY_TURNS=8

# ----------------------------------------------------------------- Resume
# RESUME_FILE_PATH=./static/resume.pdf
RESUME_FILENAME=Resume.pdf

# ----------------------------------------------------------------- Rate limits
CHAT_RATE_LIMIT_PER_MINUTE=15
CONTACT_RATE_LIMIT_PER_HOUR=5
